# Backend base URL. The proxy appends /online and /status.
# Local example: http://127.0.0.1:4558
# Cloudflare must use an address reachable from Cloudflare, normally HTTPS.
API_URL=https://api.example.com

# Optional display name; defaults to the backend's server name.
# SERVER_NAME=My Minecraft Server

# Optional expected scan interval, in minutes (does not change backend behavior).
POLL_INTERVAL_MINUTES=5

# Local development port only.
PORT=5173
